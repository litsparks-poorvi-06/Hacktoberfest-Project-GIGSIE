# Copy this file to .env and fill in your own values.
# .env is already ignored by Git - never commit a real key.

# --- Groq (GPT-OSS) - required for the AI task brief -----------------------
GROQ_API_KEY=

# --- ElevenLabs - optional, for the Gigsie Voice Brief ---------------------
# Voice Brief narrates the scope Gigsie actually generated. Everything else in
# Gigsie works without these two values.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2 when left blank.
ELEVENLABS_MODEL_ID=
